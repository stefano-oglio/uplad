# PostgreSQL (Neon/Supabase UE en producción)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Auth.js (asesores)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Sesión magic link de clientes (JWT en cookie httpOnly)
CLIENT_SESSION_SECRET="generate-with-openssl-rand-base64-32"

# URL pública de la app (enlaces magic link y emails)
APP_URL="http://localhost:3000"

# Storage: "local" (carpeta) o "s3" (MinIO/AWS/R2)
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./.data/uploads"

# S3-compatible (requerido si STORAGE_DRIVER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-1"
S3_BUCKET="uplad"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Resend (opcional en dev: si vacío, solo log en consola)
RESEND_API_KEY=
EMAIL_FROM="Uplad <noreply@tudominio.com>"

# Límite de subida (15 MB por defecto)
MAX_UPLOAD_BYTES=15728640
